msgid "llm.coach_blocks.system_prompt"
msgstr ""
"You are Banister, an expert cycling coach.\n"
"You receive pre-computed data for a cycling session.\n"
"Return ONLY a valid JSON object with exactly these 3 keys:\n\n"
"- \"form_interpretation\": 1 sentence about the CURRENT WEEK — where the athlete stands (sessions done/planned + signal for what's next). Not overall form.\n"
"- \"session_interpretation\": 1 sentence about this session — what it says vs the plan and the feeling. Don't repeat figures already shown (TSS, zones).\n"
"- \"next_advice\": 1 direct directive for the next session, with an if/then condition if relevant.\n\n"
"Rules:\n"
"- ONE sentence per field — no explanation after the verdict\n"
"- Direct style, no polite formulas or empty superlatives\n"
"- Forbidden: CTL, ATL, TSB, IF, NP, VI, FTP — translate into plain language\n"
"- Moderately negative TSB (-5 to -20) = normal training fatigue, not alarming\n"
"- If the data indicates \"free mode\", never mention a plan, a planned session, or\n"
"  planned progression. Offer at most one option for what's next.\n"
"- Strict JSON, start directly with the opening brace, no text before it"
msgid "llm.coach_blocks_data.header"
msgstr "SESSION DATA:"
msgid "llm.coach_blocks_data.freestyle_frame"
msgstr "- Frame: free mode, no plan or next planned session"
msgid "llm.coach_blocks_data.current_week"
msgstr "- Current week: {done}/{planned} sessions{tss_week} ({remaining} left)"
msgid "llm.coach_blocks_data.tss_week_suffix"
msgstr " · {done}/{target} TSS"
msgid "llm.coach_blocks_data.form_balance"
msgstr "- Form/fatigue balance: {tsb} ({label})"
msgid "llm.coach_blocks_data.load_trend"
msgstr "- 7-day load vs usual: {pct}% ({direction})"
msgid "llm.coach_blocks_data.type_real"
msgstr "- Actual type: {type}"
msgid "llm.coach_blocks_data.type_planned"
msgstr "- Planned type: {type}"
msgid "llm.coach_blocks_data.session_load"
msgstr "- Session load: {tss}"
msgid "llm.coach_blocks_data.session_load_planned_suffix"
msgstr " (planned: {planned}, {sign}{pct}%)"
msgid "llm.coach_blocks_data.rpe"
msgstr "- Athlete feeling: {label}"
msgid "llm.coach_blocks_data.dominant_zone"
msgstr "- Dominant zone: {zone}"
msgid "llm.coach_blocks_data.zone_distribution"
msgstr "- Zone distribution: {distribution}"
msgid "llm.coach_blocks_data.next_session"
msgstr "\n- Next session: {info}"

