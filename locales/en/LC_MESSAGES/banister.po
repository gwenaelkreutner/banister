msgstr "Start date (inclusive), YYYY-MM-DD format."
msgid "llm.tools.memory_query.to_date_description"
msgstr "End date (inclusive), YYYY-MM-DD format."
msgid "llm.tools.memory_query.keyword_description"
msgstr "Substring to search for, case-insensitive. Omit this field to return everything for the period."
msgid "llm.tools.memory_query.category_description"
msgstr "Optional filter on a specific category."

