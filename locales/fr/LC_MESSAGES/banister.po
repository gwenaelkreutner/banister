msgid "llm.output_language_rule"
msgstr "Écris tous les textes destinés à l'athlète en français. Traduis les libellés explicatifs, mais conserve exactement les noms, citations de l'athlète, unités, clés JSON, noms d'outils et valeurs d'entraînement."

msgid "common.welcome_new"
