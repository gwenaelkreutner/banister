msgid "llm.tools.respond_without_tool.description"
msgstr "Réponds sans outil UNIQUEMENT si aucun des autres outils ne correspond à la demande de l'athlète. Si un outil peut conserver une information que l'athlète vient de donner, choisis cet outil. Ne prétends jamais avoir lu, enregistré, modifié ou supprimé des données avec cette option."
msgid "llm.tools.respond_without_tool.answer_description"
msgstr "Réponse sans action effectuée."
