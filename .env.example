# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_OWNER_ID=your_telegram_user_id   # Get it with @userinfobot
TELEGRAM_WEBHOOK_URL=                      # Leave empty for dev (polling mode)
TELEGRAM_WEBHOOK_SECRET=banister-secret

# ── PostgreSQL (local Docker) ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://banister:password@db:5432/banister
# For local dev without Docker: postgresql+asyncpg://banister:password@localhost:5432/banister

# ── LLM Provider (anthropic | openrouter) ────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (alternative, cheaper)
# LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-...

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO          # INFO | DEBUG (verbose SQL + LLM prompts)
HOST=0.0.0.0
PORT=8000

# ── Strava OAuth (optional) ───────────────────────────────────────────────────
# Create an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_REDIRECT_URI=https://your.domain.com/auth/strava/callback
STRAVA_STATE_SECRET=random_secret_for_hmac_signing
STRAVA_WEBHOOK_VERIFY_TOKEN=random_secret_for_webhook_verification

# ── Chat model ────────────────────────────────────────────────────────────────
CHAT_MODEL=anthropic/claude-sonnet-4-6
