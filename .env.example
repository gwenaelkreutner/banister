# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Get it with @userinfobot
TELEGRAM_OWNER_ID=your_telegram_user_id
# Leave empty for polling mode (recommended — no domain/reverse proxy needed). An
# inline comment on this line (even after nothing but whitespace) becomes part of the
# value here — python-dotenv/pydantic-settings do not strip trailing "# ..." text from
# an unquoted value, so a line like "TELEGRAM_WEBHOOK_URL=   # comment" resolves to a
# truthy, garbage URL instead of "". Found live: it made a production deploy call
# bot.set_webhook() with that garbage value, which Telegram rejected, which crash-
# looped the container on every restart with no visible traceback (see Dockerfile's
# PYTHONUNBUFFERED note). Keep this variable's own line comment-free.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=banister-secret

# ── Database ──────────────────────────────────────────────────────────────────
# No configuration needed: data lives in a local SQLite file under DATA_DIR, created
# automatically on first start. Leave both of these commented out unless you need to
# change where that directory is, or point at a different database entirely.
# DATA_DIR=data
# DATABASE_URL=

# ── LLM Provider (anthropic | openrouter) ────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (alternative, cheaper)
# LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-...

# ── Application ───────────────────────────────────────────────────────────────
# English is the default. Set APP_LANGUAGE=fr to keep a French installation.
# APP_LANGUAGE=fr
ENVIRONMENT=development
# INFO | DEBUG (verbose SQL + LLM prompts)
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ── intervals.icu (sole training data source) ────────────────────────────────
# Get your API key: intervals.icu → Profile → Developer Settings → API Key
# Athlete ID is optional — "0" (the default) resolves to whichever athlete the key
# itself belongs to.
INTERVALS_API_KEY=your_intervals_api_key
# INTERVALS_ATHLETE_ID=0
INTERVALS_POLL_INTERVAL_MINUTES=5

# ── Persona ───────────────────────────────────────────────────────────────────
# Filename in personas/ without .yaml. Falls back to coach-default if unresolvable.
PERSONA=pace

# ── Chat model ────────────────────────────────────────────────────────────────
CHAT_MODEL=anthropic/claude-sonnet-4-6

# ── Observabilité LLM (Phoenix, self-hosted, optionnel) ──────────────────────
# Off par défaut — un déploiement sans conteneur Phoenix n'est pas affecté. Voir
# CLAUDE.md § Observabilité pour déployer Phoenix à côté (docker-compose séparé) et
# construire cette image avec l'extra "observability" (--build-arg INSTALL_EXTRAS=
# observability) — sans quoi PHOENIX_ENABLED=true ne trouvera pas les paquets requis.
# PHOENIX_ENABLED=true
# PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces
