# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_OWNER_ID=your_telegram_user_id   # Get it with @userinfobot
TELEGRAM_WEBHOOK_URL=                      # Leave empty for dev (polling mode)
TELEGRAM_WEBHOOK_SECRET=banister-secret

# ── Database ──────────────────────────────────────────────────────────────────
# No configuration needed: data lives in a local SQLite file under DATA_DIR, created
# automatically on first start. Leave both of these commented out unless you need to
# change where that directory is, or point at a different database entirely.
# DATA_DIR=data
# DATABASE_URL=

# ── LLM Provider (anthropic | openrouter) ────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (alternative, cheaper)
# LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-...

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO          # INFO | DEBUG (verbose SQL + LLM prompts)
HOST=0.0.0.0
PORT=8000

# ── Sport provider ────────────────────────────────────────────────────────────
SPORT_PROVIDER=intervals_icu        # intervals_icu | strava | manual

# ── intervals.icu (primary provider) ─────────────────────────────────────────
# Get your API key: intervals.icu → Profile → Developer Settings → API Key
# Get your athlete ID from the URL: intervals.icu/athlete/iXXXXXX/calendar
INTERVALS_API_KEY=your_intervals_api_key
INTERVALS_ATHLETE_ID=iXXXXXX
INTERVALS_POLL_INTERVAL_MINUTES=15

# ── Persona ───────────────────────────────────────────────────────────────────
PERSONA=coach-default               # filename in personas/ without .yaml

# ── Strava OAuth (secondary provider — read docs/STRAVA_COMPLIANCE.md first) ─
# Create an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_REDIRECT_URI=https://your.domain.com/auth/strava/callback
STRAVA_STATE_SECRET=random_secret_for_hmac_signing
STRAVA_WEBHOOK_VERIFY_TOKEN=random_secret_for_webhook_verification

# ── Chat model ────────────────────────────────────────────────────────────────
CHAT_MODEL=anthropic/claude-sonnet-4-6
