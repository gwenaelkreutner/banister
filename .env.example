# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_OWNER_ID=your_telegram_user_id   # Get it with @userinfobot
TELEGRAM_WEBHOOK_URL=                      # Leave empty for dev (polling mode)
TELEGRAM_WEBHOOK_SECRET=banister-secret

# ── Database ──────────────────────────────────────────────────────────────────
# No configuration needed: data lives in a local SQLite file under DATA_DIR, created
# automatically on first start. Leave both of these commented out unless you need to
# change where that directory is, or point at a different database entirely.
# DATA_DIR=data
# DATABASE_URL=

# ── LLM Provider (anthropic | openrouter) ────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (alternative, cheaper)
# LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-...

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO          # INFO | DEBUG (verbose SQL + LLM prompts)
HOST=0.0.0.0
PORT=8000

# ── intervals.icu (sole training data source) ────────────────────────────────
# Get your API key: intervals.icu → Profile → Developer Settings → API Key
# Athlete ID is optional — "0" (the default) resolves to whichever athlete the key
# itself belongs to.
INTERVALS_API_KEY=your_intervals_api_key
# INTERVALS_ATHLETE_ID=0
INTERVALS_POLL_INTERVAL_MINUTES=5

# ── Persona ───────────────────────────────────────────────────────────────────
PERSONA=coach-default               # filename in personas/ without .yaml

# ── Chat model ────────────────────────────────────────────────────────────────
CHAT_MODEL=anthropic/claude-sonnet-4-6
